{
  "name": "claude-companion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "claude-companion": "./cli.ts"
  },
  "scripts": {
    "start": "bun cli.ts",
    "typecheck": "tsc --noEmit -p .",
    "lint": "ast-grep test --skip-snapshot-tests && ast-grep scan && bun scripts/lint-repo.ts",
    "prepare": "git config core.hooksPath .githooks",
    "contracts:sync": "bun scripts/contracts-sync.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.1",
    "@types/bun": "^1.4.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "~7.0.2"
  }
}
