#!/usr/bin/env bash
# Deploy claude-companion or claude-config on this host now (POST /hooks/brain/deploy), always with a reason.
#
#   bin/deploy --repo claude-companion|claude-config --reason "<why now>"
#
# Normally not needed: the server deploys by itself once origin/main has stayed
# put for 2 min. Same checks either way, made by the server: only these two
# repos, on main, fast-forward only (409 not_fast_forward / dirty_overlap /
# not_on_main), never a reset or force. claude-companion restarts its own unit
# (the connection may close before the answer); claude-config runs
# claude-config-sync. Same auth as bin/pr-merge: loopback, X-Companion-Task-Id:
# brain and the pid of the brain's claude process (found by walking up the parent chain).
set -euo pipefail

REPO="" REASON=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO="$2"; shift 2 ;;
    --reason) REASON="$2"; shift 2 ;;
    *) echo "deploy: unknown flag $1" >&2; exit 2 ;;
  esac
done
case "$REPO" in claude-companion|claude-config) ;; *) echo "deploy: --repo claude-companion|claude-config is required" >&2; exit 2 ;; esac
if [ -z "$REASON" ]; then
  echo "deploy: --reason is required" >&2
  exit 2
fi

claude_pid() {
  local pid=$PPID comm
  for _ in $(seq 1 12); do
    [ -z "$pid" ] || [ "$pid" -le 1 ] && break
    comm=$(ps -o comm= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    case "$comm" in
      *claude*) echo "$pid"; return 0 ;;
    esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
  done
  echo "${PPID}"
}

BODY=$(REPO="$REPO" REASON="$REASON" python3 -c '
import json, os
print(json.dumps({"repo": os.environ["REPO"], "reason": os.environ["REASON"]}))')

curl -sS --max-time 400 -X POST "${COMPANION_URL:-http://127.0.0.1:4245}/hooks/brain/deploy" \
  -H "Content-Type: application/json" \
  -H "X-Companion-Task-Id: brain" \
  -H "X-Companion-Pid: $(claude_pid)" \
  --data-binary "$BODY" || echo '{"ok":null,"note":"connection closed — a claude-companion restart does that; the brain thread confirms the new head"}'
echo
