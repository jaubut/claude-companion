#!/usr/bin/env bash
# Inverted MCP worker CLI for the Brain and Repo Leads (POST /hooks/brain/workers-mcp).
#
#   bin/worker dispatch --task <id> --repo <repo> --prompt "<brief>" [--title "<title>"] [--family claude|codex|gemini] [--model <model>] [--mode auto] [--host local|zettlab|mac]
#   bin/worker await --task <id> [--wait-ms 30000] [--host local|zettlab|mac]
#   bin/worker interrupt --task <id> [--close-worktree] [--host local|zettlab|mac]
#   bin/worker list [--host local|zettlab|mac]
set -euo pipefail

SUB="${1:-}"
[ -n "$SUB" ] || { echo "worker: usage: bin/worker <dispatch|await|interrupt|list> [flags]" >&2; exit 2; }
shift

TASK_ID=""; REPO=""; PROMPT=""; TITLE=""; MODE="auto"; HOST="local"; WAIT_MS="30000"; CLOSE_WT="0"; AGENT=""; MODEL=""; FAMILY=""
while [ $# -gt 0 ]; do
  case "$1" in
    --task) TASK_ID="${2:-}"; shift 2 ;;
    --repo) REPO="${2:-}"; shift 2 ;;
    --prompt) PROMPT="${2:-}"; shift 2 ;;
    --title) TITLE="${2:-}"; shift 2 ;;
    --mode) MODE="${2:-}"; shift 2 ;;
    --host) HOST="${2:-}"; shift 2 ;;
    --wait-ms) WAIT_MS="${2:-}"; shift 2 ;;
    --family) FAMILY="${2:-}"; shift 2 ;;
    --agent) AGENT="${2:-}"; shift 2 ;;
    --model) MODEL="${2:-}"; shift 2 ;;
    --close-worktree) CLOSE_WT="1"; shift ;;
    *) echo "worker: unknown argument: $1" >&2; exit 2 ;;
  esac
done

claude_pid() {
  local pid=$PPID comm
  for _ in $(seq 1 12); do
    [ -z "$pid" ] || [ "$pid" -le 1 ] && break
    comm=$(ps -o comm= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    case "$comm" in
      *claude*|*codex*|*gemini*) echo "$pid"; return 0 ;;
    esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
  done
  echo "${PPID}"
}

BODY=$(SUB="$SUB" TASK_ID="$TASK_ID" REPO="$REPO" PROMPT="$PROMPT" TITLE="$TITLE" MODE="$MODE" HOST="$HOST" WAIT_MS="$WAIT_MS" CLOSE_WT="$CLOSE_WT" AGENT="$AGENT" MODEL="$MODEL" FAMILY="$FAMILY" python3 -c '
import json, os, sys
sub = os.environ["SUB"]
host = os.environ["HOST"] or "local"
if sub == "dispatch":
    args = {
        "task_id": os.environ["TASK_ID"],
        "repo": os.environ["REPO"],
        "prompt": os.environ["PROMPT"],
        "mode": os.environ["MODE"] or "auto",
        "host": host,
    }
    if os.environ["TITLE"]: args["title"] = os.environ["TITLE"]
    if os.environ["FAMILY"]: args["family"] = os.environ["FAMILY"]
    if os.environ["AGENT"]: args["agent"] = os.environ["AGENT"]
    if os.environ["MODEL"]: args["model"] = os.environ["MODEL"]
    tool = "dispatch_task"
elif sub == "await":
    args = {"task_id": os.environ["TASK_ID"], "wait_ms": int(os.environ["WAIT_MS"] or "30000"), "host": host}
    tool = "await_task"
elif sub == "interrupt":
    args = {"task_id": os.environ["TASK_ID"], "close_worktree": os.environ["CLOSE_WT"] == "1", "host": host}
    tool = "interrupt_task"
elif sub == "list":
    args = {"host": host}
    tool = "list_tasks"
else:
    sys.stderr.write(f"worker: unknown subcommand {sub}\n")
    sys.exit(2)
print(json.dumps({"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": tool, "arguments": args}}))
')

CALLER_TASK="${COMPANION_TASK_ID:-brain}"
CURL_SANDBOX_ARGS=()
if [ "${SANDBOX_RUNTIME:-}" = "1" ]; then
  CURL_SANDBOX_ARGS=(--noproxy "" -H "X-Companion-Sandbox: 1")
fi
curl -sS --max-time 140 "${CURL_SANDBOX_ARGS[@]}" -X POST "${COMPANION_URL:-http://127.0.0.1:4245}/hooks/brain/workers-mcp" \
  -H "Content-Type: application/json" \
  -H "X-Companion-Task-Id: ${CALLER_TASK}" \
  -H "X-Companion-Pid: $(claude_pid)" \
  --data-binary "$BODY"
echo
