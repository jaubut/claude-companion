#!/usr/bin/env bash
# brain-v2: fetch and analyse a video or image link on the server (POST /hooks/brain/media).
#
#   bin/media <url>     → JSON: meta, palette, transcript, frames[], contactSheet (absolute paths, open with Read)
#
# The server does the download into its own cache (~/.cache/companion/media/),
# up to ~120 s. Same auth as bin/propose: loopback, X-Companion-Task-Id: brain,
# and the pid of the brain's claude process (found by walking up the parent chain).
set -euo pipefail

URL="${1:-}"
if [ -z "$URL" ]; then
  echo 'media: usage: bin/media <url>' >&2
  exit 2
fi

claude_pid() {
  local pid=$PPID comm
  for _ in $(seq 1 12); do
    [ -z "$pid" ] || [ "$pid" -le 1 ] && break
    comm=$(ps -o comm= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    case "$comm" in
      *claude*) echo "$pid"; return 0 ;;
    esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
  done
  echo "${PPID}"
}

BODY=$(URL="$URL" python3 -c 'import json, os; print(json.dumps({"url": os.environ["URL"]}))')

curl -sS --max-time 140 -X POST "${COMPANION_URL:-http://127.0.0.1:4245}/hooks/brain/media" \
  -H "Content-Type: application/json" \
  -H "X-Companion-Task-Id: brain" \
  -H "X-Companion-Pid: $(claude_pid)" \
  --data-binary "$BODY"
echo
