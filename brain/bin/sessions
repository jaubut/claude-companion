#!/usr/bin/env bash
# brain-workers & live session messaging (POST /hooks/brain/sessions).
#
#   bin/sessions list                          → {ok, sessions:[...], mode, liveSessions:[{key, sessionId, taskId, label, title, cwd, agent, waiting}]}
#   bin/sessions send <target> "<message>"     → deliver a message from the brain to a live session (by taskId e.g. lead-<repo>, key, sessionId, or label)
#   bin/sessions tell-brain "<message>"        → relay a message from a lead-<repo> session into the brain thread
#   bin/sessions close <workspaceId>           → close one of YOUR finished workers (the server re-checks: 404 not_owned, 409 running / observe_only / self)
#
# Auth: loopback, X-Companion-Task-Id (brain or lead-<repo>), and the pid of the caller's claude process.
set -euo pipefail

OP="${1:-}" ARG1="${2:-}" ARG2="${3:-}"
case "$OP" in
  list) BODY='{"op":"list"}' ;;
  send)
    [ -n "$ARG1" ] && [ -n "$ARG2" ] || { echo "sessions: usage: bin/sessions send <target> \"<message>\"" >&2; exit 2; }
    BODY=$(TARGET="$ARG1" MSG="$ARG2" python3 -c 'import json, os; print(json.dumps({"op": "send", "target": os.environ["TARGET"], "message": os.environ["MSG"]}))') ;;
  tell-brain)
    [ -n "$ARG1" ] || { echo "sessions: usage: bin/sessions tell-brain \"<message>\"" >&2; exit 2; }
    BODY=$(MSG="$ARG1" python3 -c 'import json, os; print(json.dumps({"op": "tell-brain", "message": os.environ["MSG"]}))') ;;
  close)
    case "$ARG1" in ''|-*|*[!A-Za-z0-9_.-]*) echo "sessions: usage: bin/sessions close <workspaceId>" >&2; exit 2 ;; esac
    BODY="{\"op\":\"close\",\"workspaceId\":\"$ARG1\"}" ;;
  *) echo "sessions: usage: bin/sessions list | send <target> \"<message>\" | tell-brain \"<message>\" | close <workspaceId>" >&2; exit 2 ;;
esac

claude_pid() {
  local pid=$PPID comm
  for _ in $(seq 1 12); do
    [ -z "$pid" ] || [ "$pid" -le 1 ] && break
    comm=$(ps -o comm= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    case "$comm" in
      *claude*|*codex*|*gemini*) echo "$pid"; return 0 ;;
    esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
  done
  echo "${PPID}"
}

CALLER_TASK="${COMPANION_TASK_ID:-brain}"
curl -sS --max-time 30 -X POST "${COMPANION_URL:-http://127.0.0.1:4245}/hooks/brain/sessions" \
  -H "Content-Type: application/json" \
  -H "X-Companion-Task-Id: ${CALLER_TASK}" \
  -H "X-Companion-Pid: $(claude_pid)" \
  --data-binary "$BODY"
echo
